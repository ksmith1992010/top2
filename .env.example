# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/top2

# Node environment (development | test | production)
NODE_ENV=development

# Better Auth (required in production; dev defaults apply locally/CI when unset)
BETTER_AUTH_SECRET=development-only-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# Owner admin (kyle.smith@ottrestoration.com): set this dedicated variable to
# provision the real admin login on seed, in any environment. Min 8 chars,
# never the default dev password, never committed anywhere.
# SEED_OWNER_ADMIN_PASSWORD=

# Demo/preview admin (admin@example.com) password override. Optional locally;
# in production the demo admin additionally requires SEED_DEV_ADMIN=true and a
# non-default SEED_ADMIN_PASSWORD.
# SEED_ADMIN_PASSWORD=
# SEED_DEV_ADMIN=true
